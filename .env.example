# PostgreSQL connection string (Supabase): the "Session pooler" URI (Connect →
# Session pooler). It works over IPv4, so it also works from Docker, which has
# no IPv6 by default. The "Direct connection" URI is IPv6 only on the free tier.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth0 tenant domain (no scheme), e.g. "my-tenant.us.auth0.com".
AUTH0_DOMAIN="<tenant>.auth0.com"
# Identifier of the API registered in Auth0.
AUTH0_AUDIENCE="https://property-maintenance-api"
# Machine-to-Machine application authorized for the Auth0 Management API with
# the update:users_app_metadata scope. Used to write the profile to app_metadata at onboarding.
AUTH0_MGMT_CLIENT_ID="<client-id>"
AUTH0_MGMT_CLIENT_SECRET="<client-secret>"

# Web app origin allowed by CORS.
WEB_ORIGIN="http://localhost:5173"
