# PostgreSQL connection string (Supabase).
# Local development: "Direct connection" URI (IPv6 only on the free tier).
# Environments without IPv6 (most hosting/CI): use the "Session pooler" URI instead.
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Auth0 tenant domain (no scheme), e.g. "my-tenant.us.auth0.com".
AUTH0_DOMAIN="<tenant>.auth0.com"
# Identifier of the API registered in Auth0.
AUTH0_AUDIENCE="https://property-maintenance-api"
