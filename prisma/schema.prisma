generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum PropertyType {
  house
  building

  @@map("property_type")
}

model PropertyAdministration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  properties  Property[]
  assignments AdministrationAssignment[]
  managers    PropertyManager[]

  @@map("property_administrations")
}

model Property {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyType        PropertyType @map("property_type")
  addressStreet       String       @map("address_street")
  addressNumber       String       @map("address_number")
  addressPostalCode   String       @map("address_postal_code")
  addressIntersection String       @map("address_intersection")
  // Denormalized copy of the open assignment, for cheap reads.
  administrationId    String?      @map("administration_id") @db.Uuid
  directClientId      String?      @map("direct_client_id") @db.Uuid
  // Required by the API; null only on rows created before municipalities existed.
  municipalityId      String?      @map("municipality_id")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  administration PropertyAdministration?    @relation(fields: [administrationId], references: [id])
  directClient   User?                      @relation(fields: [directClientId], references: [id])
  municipality   Municipality?              @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  assignments    AdministrationAssignment[]
  tasks          Task[]

  @@index([administrationId])
  @@index([directClientId])
  @@index([municipalityId])
  @@map("properties")
}

// At most one open assignment (endedAt = null) per property, enforced by a
// partial unique index in a hand-written migration: Prisma can't express it.
model AdministrationAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId       String    @map("property_id") @db.Uuid
  administrationId String    @map("administration_id") @db.Uuid
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt          DateTime? @map("ended_at") @db.Timestamptz

  property       Property               @relation(fields: [propertyId], references: [id])
  administration PropertyAdministration @relation(fields: [administrationId], references: [id])

  @@index([propertyId])
  @@index([administrationId])
  @@map("administration_assignments")
}

enum UserRole {
  propertyManager
  directClient
  contractor
  tradesman

  @@map("user_role")
}

enum AdministrationRole {
  admin
  member

  @@map("administration_role")
}

enum Trade {
  electrician
  handyman
  plumber
  mason

  @@map("trade")
}

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth0Sub   String   @unique @map("auth0_sub")
  email      String   @unique
  name       String
  middleName String?  @map("middle_name")
  lastName   String   @map("last_name")
  role       UserRole
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  propertyManager PropertyManager?
  contractor      Contractor?
  tradesman       Tradesman?
  homes           Property[]
  createdTasks    Task[]
  taskEvents      TaskEvent[]

  @@map("users")
}

// administrationId and administrationRole are both set or both null (check
// constraint in a hand-written migration): null until the property manager
// creates their administration, after sign-up.
model PropertyManager {
  userId             String              @id @map("user_id") @db.Uuid
  administrationId   String?             @map("administration_id") @db.Uuid
  administrationRole AdministrationRole? @map("administration_role")

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  administration PropertyAdministration? @relation(fields: [administrationId], references: [id], onDelete: Restrict)

  @@index([administrationId])
  @@map("property_managers")
}

model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contractors Contractor[]

  @@map("companies")
}

// companyId is null until the contractor creates their Company, after sign-up.
model Contractor {
  userId    String  @id @map("user_id") @db.Uuid
  companyId String? @map("company_id") @db.Uuid

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tradesmen Tradesman[]

  @@index([companyId])
  @@map("contractors")
}

model Tradesman {
  userId        String   @id @map("user_id") @db.Uuid
  trades        Trade[]
  contractorId  String?  @map("contractor_id") @db.Uuid
  // Kept in the transaction that completes a task. The sum keeps the average
  // exact; the average is stored so searches can sort by it.
  ratingSum     Int      @default(0) @map("rating_sum")
  ratingCount   Int      @default(0) @map("rating_count")
  ratingAverage Decimal? @map("rating_average") @db.Decimal(5, 4)

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractor     Contractor?             @relation(fields: [contractorId], references: [userId])
  tasks          Task[]
  taskEvents     TaskEvent[]
  municipalities TradesmanMunicipality[]

  @@index([contractorId])
  @@map("tradesmen")
}

// Snapshot of Georef, loaded by a data migration.
model Municipality {
  id           String @id
  name         String
  // name lowercased and without accents, for accent-insensitive search.
  searchName   String @map("search_name")
  provinceId   String @map("province_id")
  provinceName String @map("province_name")

  properties Property[]
  tradesmen  TradesmanMunicipality[]

  @@index([provinceId])
  @@map("municipalities")
}

// A tradesman's service area. The key starts with the municipality, so the
// tradesmen of a municipality are an index lookup.
model TradesmanMunicipality {
  municipalityId String @map("municipality_id")
  tradesmanId    String @map("tradesman_id") @db.Uuid

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  tradesman    Tradesman    @relation(fields: [tradesmanId], references: [userId], onDelete: Cascade)

  @@id([municipalityId, tradesmanId])
  @@index([tradesmanId])
  @@map("tradesman_municipalities")
}

enum TaskStatus {
  unassigned
  assigned
  done
  completed
  cancelled
  rejected

  @@map("task_status")
}

enum TaskEventType {
  created
  assigned
  reassigned
  rejected
  rescheduled
  done
  completed
  cancelled

  @@map("task_event_type")
}

// A tradesman can't have two active tasks in the same slot, enforced by a
// partial unique index in a hand-written migration: Prisma can't express it.
model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String
  trade       Trade
  status      TaskStatus
  scheduledAt DateTime   @map("scheduled_at") @db.Timestamptz
  doneAt      DateTime?  @map("done_at") @db.Timestamptz
  completedAt DateTime?  @map("completed_at") @db.Timestamptz
  // 1 to 5 (check constraint), given by the requester when confirming.
  rating      Int?       @db.SmallInt
  cancelledAt DateTime?  @map("cancelled_at") @db.Timestamptz
  createdById String     @map("created_by_id") @db.Uuid
  tradesmanId String?    @map("tradesman_id") @db.Uuid
  propertyId  String     @map("property_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  createdBy User        @relation(fields: [createdById], references: [id])
  tradesman Tradesman?  @relation(fields: [tradesmanId], references: [userId])
  property  Property    @relation(fields: [propertyId], references: [id])
  events    TaskEvent[]

  @@index([createdById, scheduledAt])
  @@index([tradesmanId, scheduledAt])
  @@index([propertyId])
  @@map("tasks")
}

model TaskEvent {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String        @map("task_id") @db.Uuid
  type        TaskEventType
  actorId     String        @map("actor_id") @db.Uuid
  tradesmanId String?       @map("tradesman_id") @db.Uuid
  reason      String?
  rating      Int?          @db.SmallInt
  occurredAt  DateTime      @default(now()) @map("occurred_at") @db.Timestamptz

  task      Task       @relation(fields: [taskId], references: [id])
  actor     User       @relation(fields: [actorId], references: [id])
  tradesman Tradesman? @relation(fields: [tradesmanId], references: [userId])

  @@index([taskId, occurredAt])
  @@map("task_events")
}
