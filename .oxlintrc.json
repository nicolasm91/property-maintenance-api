{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "src/shared/infrastructure/persistence/prisma/generated/**"
  ],
  "overrides": [
    {
      "files": ["src/**/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*",
                  "@prisma/*",
                  "class-validator",
                  "class-transformer",
                  "express"
                ],
                "message": "Hexagonal architecture: the domain layer must not depend on frameworks or drivers."
              },
              {
                "group": ["**/application/**", "**/infrastructure/**"],
                "message": "Hexagonal architecture: the domain layer must not depend on outer layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/application/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@prisma/*",
                  "class-validator",
                  "class-transformer",
                  "express"
                ],
                "message": "Hexagonal architecture: the application layer must not depend on drivers or transport."
              },
              {
                "group": ["**/infrastructure/**"],
                "message": "Hexagonal architecture: the application layer must depend on ports, not adapters."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.spec.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
