{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error",
    "typescript/explicit-module-boundary-types": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["src/prisma/generated/**"],
  "overrides": [
    {
      "files": [
        "src/**/*.controller.ts",
        "src/**/*.service.ts",
        "src/**/dto/**",
        "src/**/entities/**",
        "src/**/repositories/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@prisma/*", "**/prisma/**"],
                "message": "Only repository implementations (repositories/prisma/) may use Prisma. Depend on the repository interface instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/health/**", "src/prisma/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
